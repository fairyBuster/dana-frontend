:80 {
    log {
        output stdout
        format console
        level info
    }

    @allowed {
        remote_ip 139.99.103.108 ::1
    }

    handle @allowed {

        root * /srv

        @api path /api/*
        handle @api {
            reverse_proxy https://croucloud.xyz {
                header_up Host croucloud.xyz
                header_up X-Forwarded-Proto {scheme}
                header_up X-Real-IP {http.request.remote}
                header_up X-Forwarded-For {http.request.header.X-Forwarded-For},{http.request.remote}
                header_up User-Agent {>User-Agent}
                header_up Accept {>Accept}
                header_up Accept-Language {>Accept-Language}
                header_up Content-Type {>Content-Type}
            }
            encode gzip zstd
        }

        try_files {path} /index.html
        encode gzip zstd
        file_server
    }

    handle {
        respond "Forbidden" 403
    }
}
