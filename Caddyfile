:80 {

    @allowed {
        remote_ip 139.99.103.108 ::1
    }

    handle @allowed {

        root * /srv

        @api path /api/*
        handle @api {
            reverse_proxy https://croucloud.xyz {
                header_up Host croucloud.xyz
                header_up X-Forwarded-Proto https
                header_up X-Original-Client-IP {http.request.header.CF-Connecting-IP}
                header_up X-Real-IP {http.request.header.CF-Connecting-IP}
                header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
            }
            encode gzip zstd
        }

        try_files {path} /index.html
        encode gzip zstd
        file_server
    }

    handle {
        respond "Forbidden" 403
    }
}
