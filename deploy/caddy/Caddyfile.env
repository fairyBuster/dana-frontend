{
        auto_https off
        servers {
                trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/12 172.64.0.0/13 131.0.72.0/22
        }
}

(security_headers) {
        header X-Content-Type-Options "nosniff"
        header X-Frame-Options "DENY"
        header X-XSS-Protection "1; mode=block"
        header Referrer-Policy "strict-origin-when-cross-origin"
        header -Server
}

(csp_policy) {
        header Content-Security-Policy "default-src 'self' data: blob:; img-src 'self' data: blob: http://localhost:* https://localhost:* capacitor://localhost https://flagcdn.com http://localhost:8000 http://localhost:5174 https://{$BACKEND_DOMAIN} https://app.otsentdrone.com https://app.otsentium.com https://app.otsentiummap.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' capacitor://localhost https://localhost http://localhost:* ws://localhost:* http://localhost:8000 http://localhost:5174 https://{$BACKEND_DOMAIN} https://cloudflareinsights.com https://app.otsentdrone.com https://app.otsentium.com https://app.otsentiummap.com; font-src 'self' data: blob: https://fonts.gstatic.com; media-src * data: blob: http://localhost:8000 http://localhost:5174 https://{$BACKEND_DOMAIN} https://app.otsentdrone.com https://app.otsentium.com https://app.otsentiummap.com; frame-src 'self' *; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
}

:80 {
        log {
                output file /var/log/caddy/frontend.log {
                        roll_size 100mb
                        roll_keep 5
                }
                format json
                level info
        }

        @allowed_ips {
                remote_ip {$ALLOWED_IPS}
        }

        handle @allowed_ips {
                import security_headers
                import csp_policy

                @bad_ua {
                        header User-Agent {curl|wget|python-requests|httpclient|scrapy|bot|spider|scan|masscan|dirbuster|nmap}
                }
                handle @bad_ua {
                        respond "Forbidden" 403
                }

                root * /var/www/frontend-spa/dist

                handle /favicon.ico {
                        header Cache-Control "public, max-age=31536000, immutable"
                        file_server
                }

                handle /index.html {
                        header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
                        header Expires "-1"
                        header Pragma "no-cache"
                        file_server
                }

                @static_files {
                        path_regexp ^.*\.(js|css|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot)$
                        not path /media/*
                }
                handle @static_files {
                        header Cache-Control "public, max-age=604800, immutable"
                        header X-Content-Type-Options "nosniff"
                        encode gzip zstd
                        file_server
                }

                @api path /api/*
                handle @api {
                        reverse_proxy {$BACKEND_SCHEME}://{$BACKEND_DOMAIN} {
                                header_up Host {$BACKEND_DOMAIN}
                                header_up X-Forwarded-Proto {$BACKEND_SCHEME}
                                header_up X-Original-Client-IP {http.request.header.CF-Connecting-IP}
                                header_up X-Real-IP {http.request.header.CF-Connecting-IP}
                                header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
                        }
                        encode gzip zstd
                }

                @logout path /logout
                handle @logout {
                        reverse_proxy {$BACKEND_SCHEME}://{$BACKEND_DOMAIN} {
                                header_up Host {$BACKEND_DOMAIN}
                                header_up X-Forwarded-Proto {$BACKEND_SCHEME}
                                header_up X-Original-Client-IP {http.request.header.CF-Connecting-IP}
                                header_up X-Real-IP {http.request.header.CF-Connecting-IP}
                                header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
                        }
                }

                @gateway path /gateway/*
                handle @gateway {
                        uri replace /gateway/ /api/
                        reverse_proxy {$BACKEND_SCHEME}://{$BACKEND_DOMAIN} {
                                header_up Host {$BACKEND_DOMAIN}
                                header_up X-Forwarded-Proto {$BACKEND_SCHEME}
                                header_up X-Original-Client-IP {http.request.header.CF-Connecting-IP}
                                header_up X-Real-IP {http.request.header.CF-Connecting-IP}
                                header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
                        }
                }

                @media_options {
                        path /media/*
                        method OPTIONS
                }
                handle @media_options {
                        header Access-Control-Allow-Origin {http.request.header.Origin}
                        header Access-Control-Allow-Methods "GET, OPTIONS"
                        header Access-Control-Allow-Headers "Authorization, Content-Type, X-Requested-With"
                        header Access-Control-Max-Age "86400"
                        header Content-Length "0"
                        respond 204
                }

                @media_content {
                        path /media/*
                }
                handle @media_content {
                        header Access-Control-Allow-Origin {http.request.header.Origin}
                        reverse_proxy {$BACKEND_SCHEME}://{$BACKEND_DOMAIN} {
                                header_up Host {$BACKEND_DOMAIN}
                                header_up X-Forwarded-Proto {$BACKEND_SCHEME}
                                header_up X-Original-Client-IP {http.request.header.CF-Connecting-IP}
                                header_up X-Real-IP {http.request.header.CF-Connecting-IP}
                                header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
                        }
                }

                @not_static {
                        not path /static/* /index.html /favicon.ico /api/* /logout /gateway/* /media/*
                        not file
                }
                handle @not_static {
                        rewrite * /index.html
                        file_server
                }

                encode gzip zstd
                file_server {
                        browse off
                }
        }

        handle {
                abort
        }

        handle_errors {
                header Content-Type "text/html; charset=utf-8"
                @404 expression `{http.error.status_code} == 404`
                handle @404 {
                        rewrite * /index.html
                        file_server
                }
                handle {
                        header Content-Type "text/plain"
                        respond "Error {http.error.status_code}" {http.error.status_code}
                }
        }
}
